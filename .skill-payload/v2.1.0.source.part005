+def _validate_parts(parts: Any) -> list[dict[str, Any]]:
+    if not isinstance(parts, list):
+        raise GuardianError("parts must be an array")
+    seen: set[str] = set()
+    for index, part in enumerate(parts):
+        if not isinstance(part, dict):
+            raise GuardianError(f"parts[{index}] must be an object")
+        unknown = set(part) - PART_KEYS
+        if unknown:
+            raise GuardianError(f"parts[{index}] has unknown keys: {sorted(unknown)}")
+        part_id = _validate_id(part.get("id"), f"parts[{index}].id")
+        if part_id in seen:
+            raise GuardianError(f"duplicate part id: {part_id}")
+        seen.add(part_id)
+        if not isinstance(part.get("name"), str) or not part["name"].strip():
+            raise GuardianError(f"parts[{index}].name must be a non-empty string")
+        if not isinstance(part.get("required", True), bool):
+            raise GuardianError(f"parts[{index}].required must be boolean")
+        _validate_mesh(part.get("mesh", {}), name=f"parts[{index}].mesh")
+        _validate_requirements(part.get("fusion_requirements", []), f"parts[{index}].fusion_requirements")
+        _validate_requirements(part.get("engineering_requirements", []), f"parts[{index}].engineering_requirements")
+        notes = part.get("notes", [])
+        if not isinstance(notes, list) or any(not isinstance(note, str) for note in notes):
+            raise GuardianError(f"parts[{index}].notes must be an array of strings")
+    return parts
