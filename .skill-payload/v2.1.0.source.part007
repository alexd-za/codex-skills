+            with self.assertRaises(GUARDIAN.GuardianError):
+                GUARDIAN.audit_stl(mesh, resource_limits=ResourceLimits(max_triangles=1))
+
+    def test_contract_can_tighten_but_not_loosen_resource_limits(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
