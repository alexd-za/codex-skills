+            with self.assertRaises(GUARDIAN.GuardianError):
+                GUARDIAN.audit_stl(
+                    mesh, contract_path=contract_path,
+                    resource_limits=ResourceLimits(max_triangles=100),
+                )
+
+    def test_coordinate_limit_rejects_pathological_mesh(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
