+    def test_json_schemas_are_valid_json(self) -> None:
+        schema_dir = Path(__file__).resolve().parents[1] / "schemas"
+        expected = {
+            "contract.schema.json", "evidence.schema.json", "export-record.schema.json",
+            "capability-profile.schema.json", "audit-report.schema.json",
+        }
+        self.assertEqual({path.name for path in schema_dir.glob("*.json")}, expected)
+        for path in schema_dir.glob("*.json"):
+            data = json.loads(path.read_text(encoding="utf-8"))
+            self.assertEqual(data["$schema"], "https://json-schema.org/draft/2020-12/schema")
+
+    def test_capability_plan_requires_discovery_then_becomes_ready(self) -> None:
+        contract = self._contract()
+        profile = default_capability_profile("Test Fusion MCP")
+        plan = build_verification_plan(contract, profile)
+        self.assertEqual(plan["readiness"], "DISCOVERY_REQUIRED")
+        required_capabilities = {
+            item.get("capability") for item in contract["fusion_requirements"] if item.get("required")
+        }
+        for capability in required_capabilities:
+            profile = set_capability(profile, capability, "available", tool=f"tool_{capability}")
+        plan = build_verification_plan(contract, profile)
+        self.assertEqual(plan["readiness"], "READY")
+        self.assertTrue(all(route["route"] == "fusion_mcp" for route in plan["routes"] if route["capability"]))
+
+    def test_required_unavailable_capability_blocks_plan(self) -> None:
+        contract = self._contract()
+        profile = default_capability_profile()
+        profile = set_capability(profile, "export_stl", "unavailable", notes="Server has no export tool")
+        plan = build_verification_plan(contract, profile)
+        self.assertEqual(plan["readiness"], "BLOCKED")
+        self.assertIn("export_selection", plan["required_blockers"])
+
+    def test_resource_limit_rejects_triangle_count(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
