+            contract_path = root / "contract.json"
+            contract_path.write_text(json.dumps(contract), encoding="utf-8")
+            evidence = default_evidence(contract)
+            evidence["design"].update({"document": "Two Part Test", "checkpoint": "V1", "fusion_mcp_server": "Fusion MCP"})
+            for check in evidence["checks"]:
+                if check["required"]:
+                    check.update({"status": "PASS", "method": "Fusion MCP", "evidence": "Verified", "source": "fusion_mcp"})
+                else:
+                    check.update({"status": "NOT_APPLICABLE", "evidence": "Optional", "source": "human_review"})
+            evidence["exports"] = [
+                {"mesh": str(base_mesh), "mesh_sha256": sha256_file(base_mesh), "part_id": "base", "component": "Base", "body": "BaseBody", "document": "Two Part Test", "checkpoint": "V1", "method": "Fusion export"},
+                {"mesh": str(arm_mesh), "mesh_sha256": sha256_file(arm_mesh), "part_id": "arm", "component": "Arm", "body": "ArmBody", "document": "Two Part Test", "checkpoint": "V1", "method": "Fusion export"},
+            ]
+            base_report = GUARDIAN.audit_stl(base_mesh, contract_path=contract_path, part_id="base")
+            missing = gate(contract, evidence, [base_report], expected_contract_sha256=sha256_file(contract_path))
+            self.assertEqual(missing["overall_verdict"], "INCOMPLETE")
+            self.assertEqual(missing["missing_required_parts"], ["arm"])
+            arm_report = GUARDIAN.audit_stl(arm_mesh, contract_path=contract_path, part_id="arm")
+            complete = gate(contract, evidence, [base_report, arm_report], expected_contract_sha256=sha256_file(contract_path))
+            self.assertEqual(complete["overall_verdict"], "PASS", complete)
+
+    def test_project_scaffold_includes_capability_profile(self) -> None:
+        with tempfile.TemporaryDirectory() as directory:
+            project = Path(directory) / "guardian-project"
+            result = GUARDIAN.create_project(project, "Multipart", "assembly", parts=[("a", "A"), ("b", "B")])
+            self.assertTrue(Path(result["capabilities"]).is_file())
+            contract = json.loads(Path(result["contract"]).read_text(encoding="utf-8"))
+            self.assertEqual([part["id"] for part in contract["parts"]], ["a", "b"])
+
+
 
 if __name__ == "__main__":
     unittest.main()
