+def validate_export_record(export: Any, *, index: int | None = None) -> dict[str, Any]:
+    label = f"evidence.exports[{index}]" if index is not None else "export record"
+    if not isinstance(export, dict):
+        raise GuardianError(f"{label} must be an object")
+    extra = set(export) - EXPORT_KEYS
+    if extra:
+        raise GuardianError(f"{label} has unknown keys: {sorted(extra)}")
+    for key in EXPORT_KEYS:
+        if key in export and not isinstance(export[key], str):
+            raise GuardianError(f"{label}.{key} must be a string")
+    if not export.get("mesh", "").strip():
+        raise GuardianError(f"{label}.mesh must be non-empty")
+    mesh_hash = export.get("mesh_sha256", "")
+    if mesh_hash and (
+        len(mesh_hash) != 64 or any(char not in "0123456789abcdefABCDEF" for char in mesh_hash)
+    ):
+        raise GuardianError(f"{label}.mesh_sha256 must be a SHA-256 hex string")
+    return export
+
+
